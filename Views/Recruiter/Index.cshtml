```cshtml
@model IEnumerable<TalentBridge.Models.Job>

@{
    ViewData["Title"] = "Recruiter Dashboard";

    var jobs = Model.ToList();
    var publishedCount = jobs.Count(j => j.IsPublished);
    var draftCount = jobs.Count(j => !j.IsPublished);
}

<div class="container py-5">

    <!-- Dashboard heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold">TALENTBRIDGE</span>
            <h1 class="fw-bold mt-2">Recruiter Dashboard</h1>
            <p class="text-secondary">
                Manage your vacancies and reach the right candidates.
            </p>
        </div>

        <a asp-controller="Recruiter"
           asp-action="Create"
           class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle me-2"></i>
            Create vacancy
        </a>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-warning alert-dismissible fade show"
             role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Dashboard statistics -->
    <div class="row g-3 mb-5">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <p class="text-secondary mb-2">Total vacancies</p>
                        <i class="bi bi-briefcase fs-4 text-primary"></i>
                    </div>

                    <h2 class="fw-bold mb-0">@jobs.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <p class="text-secondary mb-2">Published</p>
                        <i class="bi bi-check-circle fs-4 text-success"></i>
                    </div>

                    <h2 class="fw-bold text-success mb-0">
                        @publishedCount
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <p class="text-secondary mb-2">Drafts</p>
                        <i class="bi bi-file-earmark fs-4 text-warning"></i>
                    </div>

                    <h2 class="fw-bold text-warning mb-0">
                        @draftCount
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Vacancy management -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            <div class="p-4 border-bottom">
                <h4 class="fw-bold mb-1">Your vacancies</h4>
                <p class="text-secondary mb-0">
                    Create, update, publish, review applicants or remove
                    your job listings.
                </p>
            </div>

            @if (!jobs.Any())
            {
                <div class="text-center py-5 px-3">

                    <div class="display-5 mb-3">📋</div>

                    <h4 class="fw-bold">No vacancies yet</h4>

                    <p class="text-secondary">
                        Create your first vacancy to start attracting candidates.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        <i class="bi bi-plus-circle me-2"></i>
                        Create your first vacancy
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Vacancy</th>
                                <th>Location</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Closing date</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var job in jobs)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @job.Title
                                        </div>

                                        <small class="text-secondary">
                                            @job.CompanyName
                                        </small>
                                    </td>

                                    <td>@job.Location</td>

                                    <td>@job.EmploymentType</td>

                                    <td>
                                        @if (job.IsPublished)
                                        {
                                            <span class="badge text-bg-success">
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                Draft
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(job.ClosingDate.HasValue
                                            ? job.ClosingDate.Value.ToString("dd MMM yyyy")
                                            : "Not specified")
                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-flex justify-content-end flex-wrap gap-2">

                                            <!-- Review applicants -->
                                            <a asp-controller="Recruiter"
                                               asp-action="Applications"
                                               asp-route-id="@job.Id"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-people me-1"></i>
                                                Applicants
                                            </a>

                                            <!-- Edit vacancy -->
                                            <a asp-action="Edit"
                                               asp-route-id="@job.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil me-1"></i>
                                                Edit
                                            </a>

                                            <!-- Publish or unpublish -->
                                            <form asp-action="TogglePublication"
                                                  asp-route-id="@job.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-globe me-1"></i>
                                                    @(job.IsPublished ? "Unpublish" : "Publish")
                                                </button>

                                            </form>

                                            <!-- Delete vacancy -->
                                            <form asp-action="Delete"
                                                  asp-route-id="@job.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to permanently delete this vacancy?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
```