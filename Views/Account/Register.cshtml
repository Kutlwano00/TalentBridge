@model TalentBridge.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="fw-bold mb-2">Join TalentBridge</h2>

                    <p class="text-muted mb-4">
                        Create your account and take the next step
                        in your career or recruitment journey.
                    </p>

                    <form asp-controller="Account"
                          asp-action="Register"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="AccountType"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="AccountType"
                                    class="form-select form-select-lg"
                                    id="accountType">

                                <option value="Applicant">
                                    I'm looking for a job
                                </option>

                                <option value="Recruiter">
                                    I'm hiring candidates
                                </option>

                            </select>

                            <span asp-validation-for="AccountType"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3"
                             id="companyNameSection"
                             style="display: none;">

                            <label asp-for="CompanyName"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="CompanyName"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your company name" />

                            <span asp-validation-for="CompanyName"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                Enter the company you represent.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName"
                                   class="form-label">
                            </label>

                            <input asp-for="FullName"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email"
                                   class="form-label">
                            </label>

                            <input asp-for="Email"
                                   class="form-control form-control-lg"
                                   placeholder="you@example.com"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3"
                             id="profileSummarySection">

                            <label asp-for="ProfileSummary"
                                   class="form-label">
                            </label>

                            <textarea asp-for="ProfileSummary"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Tell employers a little about yourself">
                            </textarea>

                            <span asp-validation-for="ProfileSummary"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password"
                                   class="form-label">
                            </label>

                            <input asp-for="Password"
                                   class="form-control form-control-lg"
                                   placeholder="At least 8 characters"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control form-control-lg"
                                   placeholder="Re-enter your password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">
                            Create Account
                        </button>

                    </form>

                    <p class="text-center mt-4 mb-0">
                        Already registered?
                        <a asp-controller="Account"
                           asp-action="Login">
                            Sign in
                        </a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const accountType = document.getElementById("accountType");
            const companySection =
                document.getElementById("companyNameSection");
            const companyInput =
                document.getElementById("CompanyName");
            const profileSection =
                document.getElementById("profileSummarySection");

            function updateAccountFields() {
                const isRecruiter =
                    accountType.value === "Recruiter";

                companySection.style.display =
                    isRecruiter ? "block" : "none";

                profileSection.style.display =
                    isRecruiter ? "none" : "block";

                companyInput.required = isRecruiter;

                if (!isRecruiter) {
                    companyInput.value = "";
                }
            }

            accountType.addEventListener(
                "change",
                updateAccountFields
            );

            updateAccountFields();
        });
    </script>
}