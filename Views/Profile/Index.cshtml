@model TalentBridge.Models.ViewModels.ApplicantProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold">My Professional Profile</h1>
        <p class="text-muted">
            Keep your information up to date to help recruiters understand your experience and skills.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 text-center">
                    <div class="rounded-circle bg-primary bg-opacity-10
                        text-primary d-flex align-items-center
                        justify-content-center mx-auto mb-3"
                         style="width: 90px; height: 90px; font-size: 2rem;">
                        <i class="bi bi-person"></i>
                    </div>

                    <h4 class="fw-bold">@Model.FullName</h4>

                    <p class="text-muted mb-1">
                        @(string.IsNullOrWhiteSpace(Model.Location)
                            ? "Add your location"
                            : Model.Location)
                    </p>

                    <span class="badge bg-primary-subtle text-primary">
                        Applicant
                    </span>

                    <hr />

                    <p class="small text-muted mb-0">
                        Your profile helps recruiters learn more about you.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h4 class="fw-bold mb-4">Personal Information</h4>

                    <form asp-action="Index"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName"
                                       class="form-label"></label>
                                <input asp-for="FullName"
                                       class="form-control" />
                                <span asp-validation-for="FullName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber"
                                       class="form-label"></label>
                                <input asp-for="PhoneNumber"
                                       class="form-control" />
                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Location"
                                       class="form-label"></label>
                                <input asp-for="Location"
                                       class="form-control"
                                       placeholder="e.g. Johannesburg, Gauteng" />
                                <span asp-validation-for="Location"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="ProfileSummary"
                                       class="form-label"></label>
                                <textarea asp-for="ProfileSummary"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Tell recruiters about your background and career goals."></textarea>
                                <span asp-validation-for="ProfileSummary"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Education"
                                       class="form-label"></label>
                                <input asp-for="Education"
                                       class="form-control"
                                       placeholder="e.g. BSc in Information Technology" />
                                <span asp-validation-for="Education"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Skills"
                                       class="form-label"></label>
                                <textarea asp-for="Skills"
                                          class="form-control"
                                          rows="3"
                                          placeholder="e.g. C#, ASP.NET Core MVC, SQL Server, Python"></textarea>
                                <span asp-validation-for="Skills"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="CvFile"
                                       class="form-label"></label>
                                <input asp-for="CvFile"
                                       type="file"
                                       accept=".pdf,application/pdf"
                                       class="form-control" />
                                <span asp-validation-for="CvFile"
                                      class="text-danger"></span>

                                <small class="text-muted">
                                    PDF only, maximum 5 MB.
                                </small>

                               
                                @if (!string.IsNullOrWhiteSpace(Model.CvFileName))
                                {
                                    <div class="mt-3">
                                        <p class="mb-2">
                                            Current CV: <strong>@Model.CvFileName</strong>
                                        </p>

                                        <a asp-controller="Profile"
                                           asp-action="DownloadCv"
                                           class="btn btn-outline-primary btn-sm">
                                            Download My CV
                                        </a>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Save Profile
                            </button>

                            <a asp-controller="Jobs"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Browse Jobs
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
